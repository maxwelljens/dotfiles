# vim: filetype=neomuttrc

set charset = "utf-8"
set send_charset = "us-ascii:utf-8"

set date_format = "%y/%m/%d %I:%M%p"
set index_format = "%2C %Z %?X?A& ? %D %-15.15F %s (%-4.4c)"
set sort = reverse-date
set mark_old = no
set mail_check = 60

set timeout = 30
set wait_key = no

# Posteo only allows encrypted connections.
set ssl_force_tls = yes
set certificate_file = "$HOME/.config/neomutt/certificates"

# Compose
set fast_reply
set include
set forward_quote
set forward_format = "Fwd: %s"
alternative_order text/plain text/enriched text/html

# HTML rendering via mailcap
set mailcap_path = "$HOME/.config/neomutt/mailcap:$mailcap_path"
set mime_type_query_command = "file --mime-type -b %s"
auto_view text/html

# Sidebar
set sidebar_visible = yes
set sidebar_width = 22
set sidebar_short_path = yes
set sidebar_format = "%D%?F? [%F]?%* %?N?%N/? %?S?%S?"
set mail_check_stats
bind index,pager \Ck sidebar-prev
bind index,pager \Cj sidebar-next
bind index,pager \Co sidebar-open
bind index,pager B sidebar-toggle-visible

# Folder shortcuts (Posteo folder names)
bind index g noop
bind pager g noop
macro index,pager gi "<change-folder>=INBOX<enter>" "go to inbox"
macro index,pager gs "<change-folder>=Sent<enter>" "go to sent"
macro index,pager gd "<change-folder>=Drafts<enter>" "go to drafts"
macro index,pager gt "<change-folder>=Trash<enter>" "go to trash"
macro index,pager gj "<change-folder>=Junk<enter>" "go to junk"

# Open the current message's HTML part in the default browser
macro index,pager \Cf "<view-attachments><enter><quit>" "open html in browser"

source ~/.config/neomutt/accounts/posteo.muttrc
source ~/.config/neomutt/gruvbox.muttrc
