{
  "$schema": "https://charm.land/crush.json",
  "mcp": {
    "mcp_gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"]
    },
    "mcp_browser": {
      "type": "stdio",
      "command": "lightpanda",
      "args": ["mcp"]
    },
    "mcp_codemap": {
      "type": "stdio",
      "command": "codemap",
      "args": ["mcp"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "name": "rtk",
        "matcher": "bash",
        "command": "rtk-rewrite.sh"
      },
      {
        "name": "codemap",
        "command": "codemap-hooks.sh"
      }
    ]
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "edit",
      "mcp_gopls",
      "mcp_browser"
    ]
  }
}
