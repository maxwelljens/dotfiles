{
  "$schema": "https://charm.land/crush.json",
  "mcp": {
    "mcp_gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"]
    },
    "mcp_browser": {
      "type": "stdio",
      "command": "lightpanda",
      "args": ["mcp"]
    },
    "mcp_codemap": {
      "type": "stdio",
      "command": "codemap",
      "args": ["mcp"]
    },
    "mcp_godot": {
      "type": "stdio",
      "command": "deno",
      "args": ["x", "@coding-solo/godot-mcp"],
      "env": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      }
    },
    "mcp_blender": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/home/mjensen/Projekty/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "name": "rtk",
        "matcher": "bash",
        "command": "rtk-rewrite.sh"
      },
      {
        "name": "codemap",
        "command": "codemap-hooks.sh"
      }
    ]
  },
  "permissions": {
    "allowed_tools": [
      "view",
      "ls",
      "grep",
      "edit",
      "mcp_gopls",
      "mcp_browser",
      "mcp_codemap",
      "mcp_godot"
    ]
  }
}
