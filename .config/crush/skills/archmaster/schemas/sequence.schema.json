{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "diagram_type": {
      "type": "string",
      "const": "sequence"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "const": "en"
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "type": "string",
          "enum": [
            "trace",
            "none"
          ]
        },
        "visual_preset": {
          "type": "string",
          "enum": [
            "classic",
            "signal-flow",
            "blueprint",
            "editorial"
          ]
        },
        "quality_profile": {
          "type": "string",
          "enum": [
            "standard",
            "showcase"
          ]
        },
        "views": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "focus": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                }
              },
              "note": {
                "type": "string",
                "maxLength": 140
              }
            },
            "required": [
              "id",
              "label",
              "focus"
            ],
            "additionalProperties": false
          }
        },
        "column_fit": {
          "type": "string",
          "enum": [
            "fixed",
            "spread"
          ]
        },
        "legend": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "all",
                "hidden"
              ]
            },
            "entries": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "emphasis": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "security": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "dashed": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "return": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "default",
                "emphasis",
                "security",
                "dashed",
                "return"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 480
            },
            {
              "type": "number",
              "minimum": 480
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "participants": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "database",
              "cloud",
              "security",
              "messagebus",
              "external"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sublabel": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "messages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "y": {
            "type": "number",
            "minimum": 160
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "type": "string",
            "enum": [
              "default",
              "emphasis",
              "security",
              "dashed",
              "return"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "y",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "activations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "participant": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "database",
              "cloud",
              "security",
              "messagebus",
              "external"
            ]
          }
        },
        "required": [
          "participant",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dot": {
            "type": "string",
            "enum": [
              "cyan",
              "emerald",
              "violet",
              "amber",
              "rose",
              "orange",
              "slate"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dot",
          "title",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "participants",
    "messages"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/mjensen/archmaster/schemas/sequence.schema.json",
  "title": "Archmaster Sequence Diagram"
}
