{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "diagram_type": {
      "type": "string",
      "const": "architecture"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "const": "en"
        },
        "subtitle": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "animation": {
          "type": "string",
          "enum": [
            "trace",
            "none"
          ]
        },
        "visual_preset": {
          "type": "string",
          "enum": [
            "classic",
            "signal-flow",
            "blueprint",
            "editorial"
          ]
        },
        "quality_profile": {
          "type": "string",
          "enum": [
            "standard",
            "showcase"
          ]
        },
        "views": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "focus": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                }
              },
              "note": {
                "type": "string",
                "maxLength": 140
              }
            },
            "required": [
              "id",
              "label",
              "focus"
            ],
            "additionalProperties": false
          }
        },
        "engineering_profile": {
          "type": "string",
          "const": "deployment-ownership"
        },
        "repository": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+(?:\\.git)?\\/?$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{40}$"
            }
          },
          "required": [
            "url",
            "revision"
          ],
          "additionalProperties": false
        },
        "legend": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "auto",
                "all",
                "hidden"
              ]
            },
            "entries": {
              "type": "object",
              "properties": {
                "frontend": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "backend": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "database": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "cloud": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "security": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "messagebus": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "external": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "visible": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "frontend",
                "backend",
                "database",
                "cloud",
                "security",
                "messagebus",
                "external"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "viewBox": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 320
            },
            {
              "type": "number",
              "minimum": 240
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "grid"
        },
        "origin": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "gapX": {
          "type": "number",
          "minimum": 0
        },
        "gapY": {
          "type": "number",
          "minimum": 0
        },
        "cellW": {
          "type": "number",
          "minimum": 40
        },
        "cellH": {
          "type": "number",
          "minimum": 24
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "frontend",
              "backend",
              "database",
              "cloud",
              "security",
              "messagebus",
              "external"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "sublabel": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "sources": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pos": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "size": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "region",
              "security-group"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "wraps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          },
          "pad": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "label",
          "wraps"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": [
              "default",
              "emphasis",
              "security",
              "dashed"
            ]
          },
          "route": {
            "type": "string",
            "enum": [
              "auto",
              "straight",
              "orthogonal-h",
              "orthogonal-v"
            ]
          },
          "fromSide": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "toSide": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "labelAt": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "labelDx": {
            "type": "number"
          },
          "labelDy": {
            "type": "number"
          },
          "labelSegment": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "via": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "width": {
            "type": "number",
            "minimum": 0.5
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dot": {
            "type": "string",
            "enum": [
              "cyan",
              "emerald",
              "violet",
              "amber",
              "rose",
              "orange",
              "slate"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dot",
          "title",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "components"
  ],
  "additionalProperties": false,
  "$id": "https://github.com/mjensen/archmaster/schemas/architecture.schema.json",
  "title": "Archmaster Architecture Diagram"
}
