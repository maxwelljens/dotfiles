{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "lightpanda": {
      "type": "local",
      "command": [
        "lightpanda",
        "mcp"
      ],
      "enabled": true
    },
    "codemap": {
      "type": "local",
      "command": [
        "codemap",
        "mcp"
      ],
      "enabled": true
    },
    "godot": {
      "type": "local",
      "command": [
        "deno",
        "x",
        "@coding-solo/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      },
      "enabled": true,
      "timeout": 60000
    },
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/mjensen/Projekty/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "servers": {
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp?source=tinyfish_cli&client=opencode&connect_attempt_id=b3a49d83-172c-432e-a2c3-1c49b99fe773",
        "headers": {
          "X-API-Key": "sk-tinyfish-Hk4da2Ru0JRQthjvQjo8c8p_mlioAH3A"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "grep": "allow",
    "edit": "allow",
    "gopls_*": "allow",
    "lightpanda": "allow",
    "codemap_*": "allow",
    "godot_*": "allow",
    "blender_*": "allow"
  },
  "providers": {
    "google": {
      "models": {
        "gemma-r-26b-a4b-it": {
          "modelID": "gemma-4-26b-a4b-it",
          "name": "Gemma 4 26B A4B IT",
          "family": "gemma",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "agents": {
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "researcher", "effect": "allow" }
      ]
    },
    "code-executor": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "code-reviewer": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "committer": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "explore": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "debugger": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "documenter": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "terminal-worker": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "test-automator": {
	"model": "google/gemma-r-26b-a4b-it"
    },
    "researcher": {
	"model": "google/gemma-r-26b-a4b-it"
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@latest"
  ]
}
