{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "lightpanda": {
      "type": "local",
      "command": [
        "lightpanda",
        "mcp"
      ],
      "enabled": true
    },
    "codemap": {
      "type": "local",
      "command": [
        "codemap",
        "mcp"
      ],
      "enabled": true
    },
    "godot": {
      "type": "local",
      "command": [
        "deno",
        "x",
        "@coding-solo/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      },
      "enabled": true,
      "timeout": 60000
    },
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/mjensen/Projekty/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "servers": {
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp?source=tinyfish_cli&client=opencode&connect_attempt_id=b3a49d83-172c-432e-a2c3-1c49b99fe773",
        "headers": {
          "X-API-Key": "sk-tinyfish-Hk4da2Ru0JRQthjvQjo8c8p_mlioAH3A"
        }
      }
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/mjensen/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "grep": "allow",
    "edit": "allow",
    "gopls_*": "allow",
    "lightpanda": "allow",
    "codemap_*": "allow",
    "godot_*": "allow",
    "blender_*": "allow"
  },
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "researcher",
          "effect": "allow"
        }
      ]
    },
    "code-executor": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "terminal-worker",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "test-automator",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "documenter",
          "effect": "allow"
        }
      ]
    },
    "code-reviewer": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "committer": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "debugger": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "documenter": {
      "model": "xiaomi/mimo-v2.6-flash"
    },
    "terminal-worker": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "test-automator": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "researcher": {
      "model": "xiaomi/mimo-v2.6-flash"
    }
  },
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
