{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "lightpanda": {
      "type": "local",
      "command": [
        "lightpanda",
        "mcp"
      ],
      "enabled": true
    },
    "codemap": {
      "type": "local",
      "command": [
        "codemap",
        "mcp"
      ],
      "enabled": true
    },
    "godot": {
      "type": "local",
      "command": [
        "deno",
        "x",
        "@coding-solo/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      },
      "enabled": true,
      "timeout": 60000
    },
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/mjensen/Projekty/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "craft-anything": {
      "type": "local",
      "command": [
        "craft-anything.appimage",
	"--cli",
        "mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "servers": {
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp?source=tinyfish_cli&client=opencode&connect_attempt_id=b3a49d83-172c-432e-a2c3-1c49b99fe773",
        "headers": {
          "X-API-Key": "sk-tinyfish-Hk4da2Ru0JRQthjvQjo8c8p_mlioAH3A"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "grep": "allow",
    "edit": "allow",
    "gopls_*": "allow",
    "lightpanda": "allow",
    "codemap_*": "allow",
    "godot_*": "allow",
    "blender_*": "allow"
  },
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "researcher",
          "effect": "allow"
        }
      ]
    },
    "code-executor": {
      "model": "alibaba/deepseek-v4.1-flash",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "terminal-worker",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "test-automator",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "documenter",
          "effect": "allow"
        }
      ]
    },
    "code-reviewer": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "committer": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "debugger": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "documenter": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "terminal-worker": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "test-automator": {
      "model": "alibaba/deepseek-v4.1-flash"
    },
    "researcher": {
      "model": "alibaba/deepseek-v4.1-flash"
    }
  },

  // Alibaba config

  "provider": {
    "alibaba": {
      "npm": "@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "ALIBABA_API_KEY"
      },
      "models": {
        "auto": {
          "name": "Auto",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 393216
          }
        },
        "qwen4-max-preview": {
          "name": "Qwen4.0 Max Preview",
          "modalities": {
            "input": [
              "text",
