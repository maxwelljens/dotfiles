{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "lightpanda": {
      "type": "local",
      "command": [
        "lightpanda",
        "mcp"
      ],
      "enabled": true
    },
    "codemap": {
      "type": "local",
      "command": [
        "codemap",
        "mcp"
      ],
      "enabled": true
    },
    "godot": {
      "type": "local",
      "command": [
        "deno",
        "x",
        "@coding-solo/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      },
      "enabled": true,
      "timeout": 60000
    },
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/mjensen/Projekty/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "craft-anything": {
      "type": "local",
      "command": [
        "craft-anything.appimage",
	"--cli",
        "mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "servers": {
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp?source=tinyfish_cli&client=opencode&connect_attempt_id=b3a49d83-172c-432e-a2c3-1c49b99fe773",
        "headers": {
          "X-API-Key": "sk-tinyfish-Hk4da2Ru0JRQthjvQjo8c8p_mlioAH3A"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "grep": "allow",
    "edit": "allow",
    "gopls_*": "allow",
    "lightpanda": "allow",
    "codemap_*": "allow",
    "godot_*": "allow",
    "blender_*": "allow"
  },
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "researcher",
          "effect": "allow"
        }
      ]
    },
    "code-executor": {
      "model": "deepseek-v4-flash",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "terminal-worker",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "test-automator",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "documenter",
          "effect": "allow"
        }
      ]
    },
    "code-reviewer": {
      "model": "deepseek-v4-flash"
    },
    "committer": {
      "model": "deepseek-v4-flash"
    },
    "explore": {
      "model": "deepseek-v4-flash"
    },
    "debugger": {
      "model": "deepseek-v4-flash"
    },
    "documenter": {
      "model": "deepseek-v4-flash"
    },
    "terminal-worker": {
      "model": "deepseek-v4-flash"
    },
    "test-automator": {
      "model": "deepseek-v4-flash"
    },
    "researcher": {
      "model": "deepseek-v4-flash"
    }
  },

  // Tencent Cloud Token Plan (TokenHub)
  "providers": {
    "tencent": {
      "name": "Tencent Token Plan",
      "env": ["TENCENT_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://tokenhub-intl.tencentcloudmaas.com/plan/v3"
      },
      "models": {
        "auto": {
          "name": "Auto",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "hy4": {
          "name": "Hunyuan 4",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1024000,
            "output": 64000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "hy4-flash": {
          "name": "Hunyuan 4 Flash",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1024000,
            "output": 64000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "kimi-k2.6": {
          "name": "Kimi-K2.6",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 256000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "minimax-m3": {
          "name": "MiniMax-M3",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "deepseek-v4-flash-202605": {
          "name": "DeepSeek-V4-Flash Direct from Manufacturer",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1024000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "deepseek-v4-pro-202606": {
          "name": "DeepSeek-V4-Pro Direct from Manufacturer",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 1024000
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      }
    }
  }
}
