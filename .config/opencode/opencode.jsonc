{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gopls": {
      "type": "local",
      "command": [
        "gopls",
        "mcp"
      ],
      "enabled": true
    },
    "lightpanda": {
      "type": "local",
      "command": [
        "lightpanda",
        "mcp"
      ],
      "enabled": true
    },
    "codemap": {
      "type": "local",
      "command": [
        "codemap",
        "mcp"
      ],
      "enabled": true
    },
    "godot": {
      "type": "local",
      "command": [
        "deno",
        "x",
        "@coding-solo/godot-mcp"
      ],
      "environment": {
        "GODOT_PATH": "/usr/bin/godot",
        "DEBUG": "true"
      },
      "enabled": true,
      "timeout": 60000
    },
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/mjensen/Projekty/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "servers": {
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp?source=tinyfish_cli&client=opencode&connect_attempt_id=b3a49d83-172c-432e-a2c3-1c49b99fe773",
        "headers": {
          "X-API-Key": "sk-tinyfish-Hk4da2Ru0JRQthjvQjo8c8p_mlioAH3A"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "grep": "allow",
    "edit": "allow",
    "gopls_*": "allow",
    "lightpanda": "allow",
    "codemap_*": "allow",
    "godot_*": "allow",
    "blender_*": "allow"
  },
  "agents": {
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "researcher", "effect": "allow" }
      ]
    },
    "code-executor": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "code-reviewer": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "committer": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "explore": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "debugger": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "documenter": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "terminal-worker": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "test-automator": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    },
    "researcher": {
	"model": "openrouter/nvidia/nemotron-3.5-lightning:free"
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@latest"
  ]
}
